# ==============================================================================
# ArXivLens: Umgebungsvariablen-Vorlage (NIEMALS ECHTE KEYS HIER EINTRAGEN)
# Kopiere diese Datei zu '.env' für deine lokalen Tests: cp .env.example .env
# ==============================================================================

# ==============================================================================
# ArXivLens: Umgebungsvariablen-Vorlage (NIEMALS ECHTE KEYS HIER EINTRAGEN)
# Kopiere diese Datei zu '.env' für deine lokalen Tests: cp .env.example .env
# ==============================================================================

# Google Gemini API Key (100% kostenlos im Free Tier unter: https://aistudio.google.com/)
GEMINI_API_KEY=your_gemini_api_key_here

# Gemini Modell für Generation (Standard: gemini-2.0-flash oder gemini-1.5-flash)
GEMINI_MODEL=gemini-2.0-flash

# Embeddings: 'google' (nutzt text-embedding-004 via API) oder 'fastembed' (lokal CPU, kein Key nötig)
EMBEDDING_PROVIDER=google

# Re-Ranking Modell (wird lokal auf der CPU ausgeführt via FlashRank)
RERANKER_MODEL=ms-marco-TinyBERT-L-2-v2

# Vektordatenbank Persistenzpfad
CHROMA_PERSIST_DIRECTORY=./chroma_db

